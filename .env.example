# Environment Configuration (development / production)
ENVIRONMENT=development
PROJECT_NAME="FastAPI Ponytail Boilerplate"

# --- OPSI 1: SQLite (Default Lokal Cepat & Tanpa Setup Server) ---
DATABASE_URL=sqlite:///./app.db

# --- OPSI 2: MySQL Lokal (Laragon / XAMPP / Docker) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/fastapi_db

# --- OPSI 3: PostgreSQL Lokal / Docker ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fastapi_db

# --- OPSI 4: Supabase (PostgreSQL Cloud) ---
# Didapat dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Transaction Pooler / Direct)
# Gunakan postgresql+psycopg2:// sebagai schema driver:
# DATABASE_URL=postgresql+psycopg2://postgres.xxxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
